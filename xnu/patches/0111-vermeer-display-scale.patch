+	{
+		char sz[32];
+		if (PE_parse_boot_argn("sweetfb_logical", sz, sizeof(sz))) {
+			unsigned lw = 0, lh = 0;
+			if (sscanf(sz, "%ux%u", &lw, &lh) == 2 && lw > 0 && lh > 0 &&
+				lw <= SWEET_FB_LOGICAL_W && lh <= SWEET_FB_LOGICAL_H) {
+				fLogicalW = lw;
+				fLogicalH = lh;
