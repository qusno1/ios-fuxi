+/* The Goodix protocol layer's helpers (chunking lives in gx_i2c_read). */
+static int gx_i2c_read_reg(uint32_t reg, uint8_t *out, unsigned len);
+static int gx_i2c_write_reg(uint32_t reg, const uint8_t *data, unsigned len);
+
+/* GENI serial engine registers (UniXNU GeniI2c.h, BSD-2-Clause-Patent). */
+#define GENI_FW_REVISION 0x068u
+#define GENI_IF_DISABLE  0x064u
+#define GENI_CLK_CFG     0x048u
+/* GENI_CLK_SEL (0x7c) carries PROTOCOL_ID; 0x40 is the read-only
+ * SE_GENI_STATUS (the FTS-era define had them swapped). */
+#define GENI_CLK_SEL     0x07cu
+#define GENI_BYTE_GRAN   0x254u
+#define GENI_DMA_MODE    0x258u
+#define GENI_TX_PACK0    0x260u
+#define GENI_TX_PACK1    0x264u
+#define GENI_TX_LEN      0x26cu
+#define GENI_RX_LEN      0x270u
+#define GENI_SCL_COUNTERS 0x278u
+#define GENI_RX_PACK0    0x284u
+#define GENI_RX_PACK1    0x288u
+#define GENI_M_CMD0      0x600u
+#define GENI_M_CMD_CTRL  0x604u
+#define GENI_M_IRQ_STATUS 0x610u
+#define GENI_M_IRQ_EN    0x614u
+#define GENI_M_IRQ_CLEAR 0x618u
+#define GENI_TX_FIFO     0x700u
+#define GENI_RX_FIFO     0x780u
+#define GENI_RX_FIFO_STATUS 0x804u
+#define GENI_TX_WATERMARK 0x80cu
+#define GENI_SE_IRQ_EN   0xe1cu
+
+#define GENI_M_CMD_DONE   (1u << 0)
+#define GENI_M_CMD_OVERRUN (1u << 1)
+#define GENI_M_ILLEGAL_CMD (1u << 2)
+#define GENI_M_CMD_FAILURE (1u << 3)
+#define GENI_M_CMD_CANCEL (1u << 4)
+#define GENI_M_CMD_ABORT  (1u << 5)
+#define GENI_M_GP_IRQ     (0x3fu << 9)   /* NACK, bus error, arbitration lost */
+#define GENI_M_TX_WATERMARK (1u << 30)
+#define GENI_M_ERRORS (GENI_M_CMD_OVERRUN | GENI_M_ILLEGAL_CMD | \
+    GENI_M_CMD_FAILURE | GENI_M_GP_IRQ)
+#define GENI_M_IRQ_WANTED (GENI_M_CMD_DONE | GENI_M_ERRORS | \
+    GENI_M_CMD_CANCEL | GENI_M_CMD_ABORT | GENI_M_TX_WATERMARK)
+#define GENI_SE_M_IRQ_EN  (1u << 2)
+#define GENI_CMD_CTRL_ABORT (1u << 1)
+#define GENI_CMD_CTRL_CANCEL (1u << 2)
+#define GENI_PROTO_I2C    3u
+#define GENI_OP_WRITE     1u
+#define GENI_OP_READ      2u
+#define GENI_STOP_STRETCH (1u << 2)
+
+/* Goodix Berlin registers and structures. */
+#define GX_BOOTOPTION_ADDR 0x10000u
+#define GX_FW_VERSION_ADDR 0x10014u
+#define GX_IC_INFO_ADDR    0x10070u
+#define GX_IC_INFO_READ    128u          /* covers touch_data_addr @ offset 95 */
+#define GX_TOUCH_DATA_OFF  95u
+#define GX_DEV_CONFIRM     0xAAu
+#define GX_TOUCH_EVENT     (1u << 7)
+#define GX_REQUEST_EVENT   (1u << 6)
+#define GX_REQUEST_RESET   3u
+#define GX_COUNT_MASK      0xfu
+#define GX_POINT_TYPE_MASK 0xfu
+#define GX_TYPE_HOVER      1u
+#define GX_TYPE_STYLUS     3u
+#define GX_ID_SHIFT        4
+#define GX_HDR_SIZE        8u
+#define GX_TOUCH_SIZE      8u
+#define GX_CHECKSUM_SIZE   2u
+#define GX_FIRST_READ      (GX_HDR_SIZE + 2 * GX_TOUCH_SIZE + GX_CHECKSUM_SIZE)
+#define GX_RESET_DELAY_MS  100u
+
+#define GX_PANEL_X  1080u
+#define GX_PANEL_Y  2400u
+#define GX_LOGICAL_X 1125u
+#define GX_LOGICAL_Y 2436u
+
+static struct {
+	vm_offset_t se, gcc, tlmm, gpi, smmu, gsi;
+	vm_offset_t dma;
+	uint64_t dma_pa;
+	unsigned wp[2], evrp;
+	uint32_t touch_data_addr;
+	bool started;
+	int x[GX_MAX], y[GX_MAX];
+	uint32_t active;
+	unsigned errors;
+} gx;
+
+static uint32_t
+gx_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+gx_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+gx_sleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gx, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint64_t
+gx_deadline(unsigned us)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(us, NSEC_PER_USEC, &deadline);
+	return mach_absolute_time() + deadline;
+}
+
+/* TLMM: pull [1:0], func [5:2], drive [8:6], OE [9] — as fuxi_touch.c. */
+static void
+gx_gpio(unsigned n, unsigned func, unsigned pull, unsigned ma, int out)
+{
+	if (out >= 0) {
+		gx_wr(gx.tlmm, GX_GPIO(n) + 4, out ? 2u : 0u);
+	}
+	gx_wr(gx.tlmm, GX_GPIO(n), (gx_rd(gx.tlmm, GX_GPIO(n)) & ~0x3ffu) | pull |
+	    (func << 2) | ((ma / 2 - 1) << 6) | (out >= 0 ? 0x200u : 0u));
+}
+
+static bool
+gx_on(uint32_t cbcr)
+{
+	return !(gx_rd(gx.gcc, cbcr) & 0x80000000u);
+}
+
+/* Clock votes: identical to fuxi_touch.c ft_clock (the same QUP1-SE4 engine). */
+static int
+gx_clock(void)
+{
+	gx_wr(gx.gcc, 0x52008, gx_rd(gx.gcc, 0x52008) | (0xfu << 18) | (1u << 26));
+	for (unsigned i = 0; i < 10000 && !gx_on(0x2327c); i++) {
+		delay(1);
+	}
+	if (!gx_on(0x2327c)) {
+		printf("GX TOUCH: wrapper1 AHB off (vote %#x)\n", gx_rd(gx.gcc, 0x52008));
+		return EIO;
+	}
+	unsigned level = 0;
+	if (gx_rd(gx.gcc, 0x18504) & 1u) {
+		while (level < 8 && (gx_rd(gx.gcc, 0x1850c + 4 * level) & 0x71fu) > 1u) {
+			level++;
+		}
+	} else if ((gx_rd(gx.gcc, 0x184f4) & 0x71fu) > 1u) {
+		level = 8;
+	}
+	if (level == 8) {
+		printf("GX TOUCH: no XO clock level\n");
+		return EIO;
+	}
+	gx_wr(gx.se, 0x07c, level);
+	gx_wr(gx.se, 0x048, (2u << 4) | 1u);
+	for (unsigned i = 0; i < 10000 && !gx_on(0x184e4); i++) {
+		delay(1);
+	}
+	if (!gx_on(0x184e4)) {
+		printf("GX TOUCH: SE4 clock off (cbcr %#x)\n", gx_rd(gx.gcc, 0x184e4));
+		return EIO;
+	}
+	return 0;
+}
+
+/* GENI I2C GPI-DMA transfers: the FTS machinery (the same engine, the same
+ * GPII0 channels and SMMU SMRs) with the I2C protocol encoding and the
+ * Berlin register-address bytes as the I2C payload. */
+
+static void
+gx_dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(gx.dma_pa + off), len, TRUE);
+}
+
+static uint32_t
+gx_state(uint32_t ctx)
+{
+	return (gx_rd(gx.gpi, ctx) >> 20) & 0xf;
+}
+
+static bool
+gx_gpi_cmd(uint32_t reg, uint32_t v, uint32_t ctx, uint32_t want)
+{
+	gx_wr(gx.gpi, GPI_GPII + reg, v);
+	for (unsigned i = 0; i < 50000; i++) {
+		uint32_t st = gx_state(ctx);
+		if (st == want) {
+			gx_wr(gx.gpi, GPI_GPII + 0xa0, gx_rd(gx.gpi, GPI_GPII + 0x90));
+			gx_wr(gx.gpi, GPI_GPII + 0xa4, gx_rd(gx.gpi, GPI_GPII + 0x94));
+			return true;
+		}
+		if (st == 0xf) {
+			break;
+		}
+		delay(1);
+	}
+	printf("GX TOUCH: GPI cmd %#x -> state %#x (want %u)\n", v, gx_state(ctx), want);
+	return false;
+}
+
+/* SMMU: route the QUP1 and GPII streams to CB4 bypass — as fuxi_touch.c. */
+static int
+gx_smmu(void)
+{
+	static const uint16_t sid[] = {0xb6, 0xa3};
+	uint32_t nsmr = gx_rd(gx.smmu, 0x20) & 0xff;
+	for (unsigned j = 0; j < 2; j++) {
+		unsigned i, freei = ~0u;
+		for (i = 0; i < nsmr; i++) {
+			uint32_t smr = gx_rd(gx.smmu, 0x800 + 4 * i);
+			if (!(smr & 0x80000000u)) {
+				if (freei == ~0u) {
+					freei = i;
+				}
+				continue;
+			}
+			if (((sid[j] ^ smr) & ~(smr >> 16) & 0x7fff) == 0) {
+				break;
+			}
+		}
+		if (i < nsmr) {
+			continue;
+		}
+		if (freei == ~0u) {
+			return ENOSPC;
+		}
+		gx_wr(gx.smmu, 0xc00 + 4 * freei, 4);
+		gx_wr(gx.smmu, 0x800 + 4 * freei, 0x80000000u | sid[j]);
+		printf("GX TOUCH: SMR %u = sid %#x -> S2CR %#x\n", freei, sid[j],
+		    gx_rd(gx.smmu, 0xc00 + 4 * freei));
+	}
+	return 0;
+}
+
+/* GPI teardown: stop, reset and free the channels and the event ring. */
+static void
+gx_gpi_teardown(void)
+{
+	for (unsigned k = 0; k < 2; k++) {
+		if (gx_state(GPI_CH(k)) == 2) {
+			(void)gx_gpi_cmd(0x08, (2u << 24) | k, GPI_CH(k), 3);
+		}
+		if (gx_state(GPI_CH(k))) {
+			(void)gx_gpi_cmd(0x08, (9u << 24) | k, GPI_CH(k), 1);
+			gx_wr(gx.gpi, GPI_GPII + 0x08, (10u << 24) | k);
+			delay(1000);
+		}
+	}
+	if (gx_state(GPI_EV)) {
+		(void)gx_gpi_cmd(0x10, 9u << 24, GPI_EV, 1);
+		gx_wr(gx.gpi, GPI_GPII + 0x10, 10u << 24);
+		delay(1000);
+	}
+}
+
+/* GPI setup against the mapped window: the FTS engine-level wroll, the event
+ * ring, both channels with the I2C encodings, then START. CNTXT_0 PROTO is
+ * the channel TYPE (GPI_CHTYPE_PROTO_GPI = 2, mainline gpi_alloc_chan); the
+ * peripheral protocol (QCOM_GPI_I2C = 3) lives in SCRATCH_0 only. */
+static int
+gx_gpi_setup(void)
+{
+	uint32_t lo = (uint32_t)gx.dma_pa, hi = (uint32_t)(gx.dma_pa >> 32);
+	bzero((void *)gx.dma, PAGE_SIZE);
+	gx_dma_sync(0, PAGE_SIZE);
+	gx_wr(gx.gpi, GPI_GPII + 0x88, 0x4f);
+	gx_wr(gx.gpi, GPI_GPII + 0xb8, 1);
+	gx_wr(gx.gpi, GPI_GPII + 0x98, 3);
+	gx_wr(gx.gpi, GPI_GPII + 0x9c, 1);
+	gx_wr(gx.gpi, GPI_GPII + 0x108, 1);
+	gx_wr(gx.gpi, GPI_GPII + 0x120, 0xf);
+	gx_wr(gx.gpi, GPI_GPII + 0x188, 0);
+	gx_wr(gx.gpi, GPI_GPII + 0x18c, 0);
+	gx_wr(gx.gpi, GPI_GPII + 0x400, 0);
+	gx_wr(gx.gpi, GPI_GPII + 0x404, 0);
+	gx_wr(gx.gpi, GPI_GPII + 0x180, 1);
+	gx_wr(gx.gpi, GPI_GPII + 0x200, 0);
+	if (!gx_gpi_cmd(0x10, 0, GPI_EV, 1)) {
+		return EIO;
+	}
+	gx_wr(gx.gpi, GPI_EV + 0x00, 0x10010002u);
+	gx_wr(gx.gpi, GPI_EV + 0x04, GX_EVRING * 16);
+	gx_wr(gx.gpi, GPI_EV + 0x08, lo + GX_EV_OFF);
+	gx_wr(gx.gpi, GPI_EV + 0x0c, hi);
+	gx_wr(gx.gpi, GPI_EVDB + 4, hi);
+	for (uint32_t o = 0x20; o <= 0x34; o += 4) {
+		gx_wr(gx.gpi, GPI_EV + o, 0);
+	}
+	gx.evrp = 0;
+	gx_wr(gx.gpi, GPI_EVDB, lo + GX_EV_OFF + GX_EVRING * 16 - 16);
+	for (unsigned k = 0; k < 2; k++) {
+		if (!gx_gpi_cmd(0x08, k, GPI_CH(k), 1)) {
+			return EIO;
+		}
+		/* CNTXT_0: PROTO = GPI_CHTYPE_PROTO_GPI (2) — the channel TYPE
+		 * field, not the peripheral protocol (SCRATCH_0 carries that);
+		 * EL_SIZE = 16 (sizeof TRE); TX channel sets DIR. */
+		gx_wr(gx.gpi, GPI_CH(k) + 0x00, k ? 0x10000002u : 0x1000000au);
+		gx_wr(gx.gpi, GPI_CH(k) + 0x04, GX_RING * 16);
+		gx_wr(gx.gpi, GPI_CH(k) + 0x08, lo + GX_RING_OFF(k));
+		gx_wr(gx.gpi, GPI_CH(k) + 0x0c, hi);
+		gx_wr(gx.gpi, GPI_CHDB(k) + 4, hi);
+		/* SCRATCH_0: pair, proto QCOM_GPI_I2C (3), SE 4. */
+		gx_wr(gx.gpi, GPI_CH(k) + 0x60, k ? 0x00000034u : 0x00010034u);
+		gx_wr(gx.gpi, GPI_CH(k) + 0x64, 0);
+		gx_wr(gx.gpi, GPI_CH(k) + 0x68, 0);
+		gx_wr(gx.gpi, GPI_CH(k) + 0x6c, 0);
+		gx_wr(gx.gpi, GPI_CH(k) + 0x5c, 1);
+		gx.wp[k] = 0;
+	}
+	for (unsigned k = 0; k < 2; k++) {
+		if (!gx_gpi_cmd(0x08, (1u << 24) | k, GPI_CH(k), 2)) {
+			printf("GX TOUCH: ch%u start fail CNTXT_0 %#x scratch %#x\n", k,
+			    gx_rd(gx.gpi, GPI_CH(k)), gx_rd(gx.gpi, GPI_CH(k) + 0x60));
+			return EIO;
+		}
+	}
+	return 0;
+}
+
+/* The QUP1 GPI engine sits at 0xa00000 (vermeer live.dtb gpi-dma@a00000) and
+ * mainline gpi.c places the GPII windows at engine + 0x20000. The FTS's
+ * 0xa10000 is the FUXI engine base (0x9f0000) + 0x20000 — probe both, the
+ * window whose channel state machine actually responds wins. */
+static int
+gx_gpi_init(void)
+{
+	static const uintptr_t bases[] = { 0x00a20000u, 0x00a10000u };
+	for (unsigned i = 0; i < sizeof(bases) / sizeof(bases[0]); i++) {
+		gx.gpi = ml_io_map(bases[i], 0x4000);
+		if (!gx.gpi) {
+			continue;
+		}
+		gx_gpi_teardown();
+		if (gx_gpi_setup() == 0) {
+			printf("GX TOUCH: GPI window %#x\n", (uint32_t)bases[i]);
+			return 0;
+		}
+		gx_gpi_teardown();
+	}
+	gx.gpi = 0;
+	return EIO;
+}
