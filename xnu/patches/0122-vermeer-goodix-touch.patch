+/* Load the QUP1 GSI MCS firmware (the GPI engine runs its own core). */
+static int
+gx_gsi_fw_load(void)
+{
+	unsigned i;
+	gx.gsi = ml_io_map(GX_GSI_TOP_PA, 0x50000u);
+	if (!gx.gsi) {
+		return ENOMEM;
+	}
+	gx_wr(gx.gsi, GSI_CGC_CTRL, gx_rd(gx.gsi, GSI_CGC_CTRL) & ~(1u << 2));
+	gx_wr(gx.gsi, GSI_PERIPH_BASE_LSB, 0);
+	gx_wr(gx.gsi, GSI_PERIPH_BASE_MSB, 0);
+	for (i = 0; i < GX_GSI_IEP_N; i++) {
+		if (gx_gsi_iep[i][0] < 0x5000u) {
+			gx_wr(gx.gsi, gx_gsi_iep[i][0], gx_gsi_iep[i][1]);
+		}
+	}
+	gx_wr(gx.gsi, GSI_MANAGER_MCS_CODE_VER, gx_gsi_lines[0]);
+	for (i = 0; i < GX_GSI_LINES_N; i++) {
+		gx_wr(gx.gsi, GSI_INST_RAMN + 8 * i, gx_gsi_lines[2 * i]);
+		gx_wr(gx.gsi, GSI_INST_RAMN + 8 * i + 4, gx_gsi_lines[2 * i + 1]);
+	}
+	gx_wr(gx.gsi, GSI_MCS_CFG, gx_rd(gx.gsi, GSI_MCS_CFG) | 1u);
+	gx_wr(gx.gsi, GSI_CFG, gx_rd(gx.gsi, GSI_CFG) | (1u << 2) | 1u);
+	gx_wr(gx.gsi, GSI_EE_N_SCRATCH_0, 0);
+	gx_wr(gx.gsi, GSI_EE_N_GSI_EE_GENERIC_CMD, 0x81);
+	for (i = 0; i < 50000; i++) {
+		if (gx_rd(gx.gsi, GSI_EE_N_SCRATCH_0) <= 1u) {
+			printf("GX TOUCH: GSI fw up, scratch %#x after %u us\n",
+			    gx_rd(gx.gsi, GSI_EE_N_SCRATCH_0), i);
+			return 0;
+		}
+		delay(1);
+	}
+	printf("GX TOUCH: GSI fw load timeout (scratch %#x)\n",
+	    gx_rd(gx.gsi, GSI_EE_N_SCRATCH_0));
+	return ETIMEDOUT;
+}
+
+static void
+gx_tre(unsigned k, uint32_t d0, uint32_t d1, uint32_t d2, uint32_t d3)
+{
+	uint32_t off = GX_RING_OFF(k) + 16 * gx.wp[k];
+	volatile uint32_t *t = (volatile uint32_t *)(gx.dma + off);
+	t[0] = d0;
+	t[1] = d1;
+	t[2] = d2;
+	t[3] = d3;
+	gx_dma_sync(off, 16);
+	gx.wp[k] = (gx.wp[k] + 1) % GX_RING;
+}
+
+static void
+gx_ring_db(unsigned k)
+{
+	__asm__ volatile("dsb sy" ::: "memory");
+	gx_wr(gx.gpi, GPI_CHDB(k), (uint32_t)gx.dma_pa + GX_RING_OFF(k) + 16 * gx.wp[k]);
+}
+
+/* Drain events until an end-of-transfer (code 2) from chid arrives. */
+static int
+gx_gpi_wait(unsigned chid, uint32_t *len)
+{
+	for (unsigned us = 0; us < 5000; us++) {
+		uint32_t hw = gx_rd(gx.gpi, GPI_EV + 0x10);
+		bool found = false, bad = false;
+		while (hw != (uint32_t)gx.dma_pa + GX_EV_OFF + 16 * gx.evrp) {
+			uint32_t off = GX_EV_OFF + 16 * gx.evrp;
+			gx_dma_sync(off, 16);
+			volatile uint32_t *e = (volatile uint32_t *)(gx.dma + off);
+			uint32_t d2 = e[2], d3 = e[3];
+			gx.evrp = (gx.evrp + 1) % GX_EVRING;
+			unsigned code = d2 >> 24, type = (d3 >> 16) & 0xff, ch = d3 >> 24;
+			if (code == 16 || type == 0xff || ch >= 2) {
+				bad = true;
+				printf("GX TOUCH: GPI event %#x %#x\n", d2, d3);
+			} else if (type == 0x22 && ch == chid && code == 2) {
+				found = true;
+				*len = d2 & 0xffffff;
+			}
+		}
+		gx_wr(gx.gpi, GPI_EVDB, (uint32_t)gx.dma_pa + GX_EV_OFF +
+		    16 * ((gx.evrp + GX_EVRING - 1) % GX_EVRING));
+		gx_wr(gx.gpi, GPI_GPII + 0xc0, 1);
+		if (bad) {
+			return EIO;
+		}
+		if (found) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+/* I2C write: GO(WRITE, 0x5d) + DMA(reg32 BE + data). len <= 60. */
+static int
+gx_i2c_write(uint32_t reg, const uint8_t *data, unsigned len)
+{
+	uint32_t total = 4 + len, dlen = 0;
+	int err;
+	if (len > 60 - 4) {
+		return EINVAL;
+	}
+	uint8_t *txb = (uint8_t *)(gx.dma + GX_TXB_OFF);
+	txb[0] = (uint8_t)(reg >> 24);
+	txb[1] = (uint8_t)(reg >> 16);
+	txb[2] = (uint8_t)(reg >> 8);
+	txb[3] = (uint8_t)reg;
+	for (unsigned i = 0; i < len; i++) {
+		txb[4 + i] = data[i];
+	}
+	gx_dma_sync(GX_TXB_OFF, total);
+	gx_tre(0, GX_GO(GX_I2C_WRITE, 0x5d, false), 0, 0, GX_GO_FLAGS);
+	gx_tre(0, (uint32_t)gx.dma_pa + GX_TXB_OFF, (uint32_t)(gx.dma_pa >> 32), total,
+	    GX_DMA_FLAGS);
+	gx_ring_db(0);
+	if ((err = gx_gpi_wait(0, &dlen))) {
+		return err;
+	}
+	return dlen == total ? 0 : EIO;
+}
+
+/* I2C read: transfer A writes the 32-bit register address; transfer B reads
+ * len bytes (GO carries rx_len; the data lands in the RX buffer). */
+static int
+gx_i2c_read(uint32_t reg, uint8_t *out, unsigned len)
+{
+	uint32_t dlen = 0, alen = 0;
+	int err;
+	if (len > 128) {
+		return EINVAL;
+	}
+	uint8_t *txb = (uint8_t *)(gx.dma + GX_TXB_OFF);
+	txb[0] = (uint8_t)(reg >> 24);
+	txb[1] = (uint8_t)(reg >> 16);
+	txb[2] = (uint8_t)(reg >> 8);
+	txb[3] = (uint8_t)reg;
+	gx_dma_sync(GX_TXB_OFF, 4);
+	/* reg-addr write holds the bus (stretch) for the repeated-start read */
+	gx_tre(0, GX_GO(GX_I2C_WRITE, 0x5d, true), 0, 0, GX_GO_FLAGS);
+	gx_tre(0, (uint32_t)gx.dma_pa + GX_TXB_OFF, (uint32_t)(gx.dma_pa >> 32), 4,
+	    GX_DMA_FLAGS);
+	gx_ring_db(0);
+	if ((err = gx_gpi_wait(0, &alen))) {
+		return err;
+	}
+	if (alen != 4) {
+		return EIO;
+	}
+	gx_dma_sync(GX_RXB_OFF, len);
+	gx_tre(1, (uint32_t)gx.dma_pa + GX_RXB_OFF, (uint32_t)(gx.dma_pa >> 32), len,
+	    GX_DMA_FLAGS);
+	/* read GO links to the paired RX-channel DMA (Linux gpi.c multi_msg) */
+	gx_tre(0, GX_GO(GX_I2C_READ, 0x5d, false), 0, len, GX_GO_FLAGS_LINK);
+	gx_ring_db(1);
+	gx_ring_db(0);
+	if ((err = gx_gpi_wait(1, &dlen))) {
+		return err;
+	}
+	gx_dma_sync(GX_RXB_OFF, len);
+	memcpy(out, (const void *)(gx.dma + GX_RXB_OFF), len);
+	return 0;
+}
+
+static int
+gx_i2c_read_reg(uint32_t reg, uint8_t *out, unsigned len)
+{
+	return gx_i2c_read(reg, out, len);
+}
+
+static int
+gx_i2c_write_reg(uint32_t reg, const uint8_t *data, unsigned len)
+{
+	return gx_i2c_write(reg, data, len);
+}
+
+static uint16_t
+gx_checksum(const uint8_t *p, uint32_t len)
+{
+	uint16_t sum = 0;
+	for (uint32_t i = 0; i < len; i++) {
+		sum += p[i];
+	}
+	return sum;
+}
+
+/* The RX FIFO holds 16 words (64 B): chunk reads beyond that. The Berlin
+ * protocol allows a read at any 32-bit address, so chunk boundaries are free. */
+static int
+gx_read32(uint32_t reg, uint8_t *out, uint32_t len)
+{
+	while (len) {
+		uint32_t n = len > 60u ? 60u : len;
+		int err = gx_i2c_read_reg(reg, out, n);
+		if (err) {
+			return err;
+		}
+		reg += n;
+		out += n;
+		len -= n;
+	}
+	return 0;
+}
+
+static int
+gx_dev_confirm(void)
+{
+	uint8_t data[4] = {0};
+	int err = gx_read32(GX_BOOTOPTION_ADDR, data, 4);
+	if (err) {
+		return err;
+	}
+	if (data[0] != GX_DEV_CONFIRM || data[1] != GX_DEV_CONFIRM ||
+	    data[2] != GX_DEV_CONFIRM || data[3] != GX_DEV_CONFIRM) {
+		printf("GX TOUCH: dev confirm mismatch %02x %02x %02x %02x\n",
+		    data[0], data[1], data[2], data[3]);
+		return EIO;
+	}
+	uint8_t zero = 0;
+	return gx_i2c_write_reg(GX_BOOTOPTION_ADDR, &zero, 1);
+}
+
+static int
+gx_read_version(void)
+{
+	uint8_t v[19] = {0};
+	int err = gx_read32(GX_FW_VERSION_ADDR, v, sizeof(v));
+	if (err) {
+		return err;
+	}
+	printf("GX TOUCH: patch pid %.8s vid %.4s sensor %u\n",
+	    (const char *)&v[9], (const char *)&v[17], v[21]);
+	return 0;
+}
+
+static int
+gx_read_ic_info(void)
+{
+	uint8_t info[GX_IC_INFO_READ] = {0};
+	int err = gx_read32(GX_IC_INFO_ADDR, info, sizeof(info));
+	if (err) {
+		return err;
+	}
+	uint32_t addr = info[GX_TOUCH_DATA_OFF] |
+	    (uint32_t)info[GX_TOUCH_DATA_OFF + 1] << 8 |
+	    (uint32_t)info[GX_TOUCH_DATA_OFF + 2] << 16 |
+	    (uint32_t)info[GX_TOUCH_DATA_OFF + 3] << 24;
+	if (!addr || addr > 0x1ffffu) {
+		printf("GX TOUCH: bad touch_data_addr %#x\n", addr);
+		return EIO;
+	}
+	gx.touch_data_addr = addr;
+	printf("GX TOUCH: touch_data_addr %#x\n", addr);
+	return 0;
+}
+
+/* One poll: read the event header + 2 contacts, extend for more, checksum,
+ * parse, deliver through the same path the FTS driver uses. */
+static void
+gx_poll(bool deliver)
+{
+	uint8_t e[GX_FIRST_READ + 8 * (GX_MAX - 2)] = {0};
+	uint32_t mask = gx.active;
+	uint8_t hdr[GX_HDR_SIZE];
+	int err = gx_read32(gx.touch_data_addr, hdr, GX_HDR_SIZE);
+	if (err) {
+		return;
+	}
+	if (hdr[0] == 0) {
+		return;
+	}
+	if (gx_checksum(hdr, 6) != (uint16_t)(hdr[6] | hdr[7] << 8)) {
+		printf("GX TOUCH: header checksum error\n");
+		goto out_clear;
+	}
+	uint8_t req = hdr[2];
+	if (req & GX_TOUCH_EVENT) {
+		uint8_t count = req & GX_COUNT_MASK;
+		if (count > GX_MAX) {
+			goto out_clear;
+		}
+		uint32_t len = count * GX_TOUCH_SIZE + GX_CHECKSUM_SIZE;
+		if ((err = gx_read32(gx.touch_data_addr + GX_HDR_SIZE, e,
+		    len)) != 0) {
+			goto out_clear;
+		}
+		if (count && gx_checksum(e, len - GX_CHECKSUM_SIZE) !=
+		    (uint16_t)(e[len - 2] | e[len - 1] << 8)) {
+			printf("GX TOUCH: touch checksum error\n");
+			goto out_clear;
+		}
+		bool changed = false;
+		for (uint8_t k = 0; k < count; k++) {
+			const uint8_t *t = e + k * GX_TOUCH_SIZE;
+			uint8_t st = t[0];
+			unsigned id = st >> GX_ID_SHIFT;
+			unsigned type = st & GX_POINT_TYPE_MASK;
+			if (id >= GX_MAX) {
+				continue;
+			}
+			int x = t[2] | t[3] << 8;
+			int y = t[4] | t[5] << 8;
+			/* panel 1080x2400 -> logical 1125x2436 */
+			x = x * (int)GX_LOGICAL_X / (int)GX_PANEL_X;
+			y = y * (int)GX_LOGICAL_Y / (int)GX_PANEL_Y;
+			if (x >= (int)GX_LOGICAL_X) {
+				x = GX_LOGICAL_X - 1;
+			}
+			if (y >= (int)GX_LOGICAL_Y) {
+				y = GX_LOGICAL_Y - 1;
+			}
+			bool touching = type != 0 && type != GX_TYPE_HOVER;
+			if (deliver) {
+				gx.x[id] = x;
+				gx.y[id] = y;
+				if (touching) {
+					mask |= 1u << id;
+				} else {
+					mask &= ~(1u << id);
+				}
+			}
+			changed = true;
+		}
+		if (deliver && changed) {
+			fuxi_perf_input();
+			for (unsigned id = 0; id < GX_MAX; id++) {
+				uint32_t bit = 1u << id;
+				if (mask & bit && !(gx.active & bit)) {
+					sweet_hid_touch((int)id, 1, gx.x[id], gx.y[id]);
+				} else if (!(mask & bit) && (gx.active & bit)) {
+					sweet_hid_touch((int)id, 0, gx.x[id], gx.y[id]);
+				}
+			}
+			gx.active = mask;
+		}
+	}
+out_clear:
+{
+	uint8_t zero = 0;
+	(void)gx_i2c_write_reg(gx.touch_data_addr, &zero, 1);
+}
+}
+
+static void
+gx_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 30, poll_us = 4000;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("fuxitouchgoodixdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("fuxitouch_poll_us", &poll_us, sizeof(poll_us));
+	poll_us = poll_us < 1000 ? 1000 : poll_us;
+	printf("GX TOUCH: starting in %u s (poll %u us)\n", delay_s, poll_us);
+	gx_sleep(delay_s * 1000u);
+	gx.gcc = ml_io_map(GX_GCC_PA, 0x1f0000);
+	gx.tlmm = ml_io_map(GX_TLMM_PA, 0x30000);
+	gx.se = ml_io_map(GX_SE_PA, 0x4000);
+	gx.smmu = ml_io_map(GX_SMMU_PA, 0x1000);
+	if (!gx.gcc || !gx.tlmm || !gx.se || !gx.smmu) {
+		goto out;
+	}
+	if (kmem_alloc_contig(kernel_map, &gx.dma, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("GX TOUCH: no DMA memory\n");
+		goto out;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)gx.dma);
+	if (!pn) {
+		goto out;
+	}
+	gx.dma_pa = ptoa_64(pn);
+	/* The FTS bring-up order: SE first (I2C firmware + GPI-DMA mode), then
+	 * SMMU, then the GPI channels — the engine refuses channel START while
+	 * the target SE is not in DMA mode. gx_clock's votes are fuxi GCC
+	 * offsets — deliberately not run here (the loader leaves QUP1 clocked,
+	 * the SE reads back its I2C firmware revision without them). */
+	(void)gx_clock;
+	int ierr;
+	if ((ierr = gx_se_fw_load())) {
+		printf("GX TOUCH: se fw load failed %d\n", ierr);
+		goto out;
+	}
+	if ((ierr = gx_gsi_fw_load())) {
+		printf("GX TOUCH: gsi fw load failed %d\n", ierr);
+		goto out;
+	}
+	if ((ierr = gx_smmu()) || (ierr = gx_gpi_init())) {
+		printf("GX TOUCH: init (smmu/gpi) failed %d\n", ierr);
+		goto out;
+	}
+	printf("GX TOUCH: engine up (fw rev %#x)\n", gx_rd(gx.se, GENI_FW_REVISION));
+
+	/* reset: GPIO 24 high 2 ms (active high per the DT flags 0), then 100 ms */
+	gx_gpio(GX_RESET, 0, 3, 8, 1);
+	gx_sleep(2);
+	gx_gpio(GX_RESET, 0, 3, 8, 0);
+	gx_sleep(GX_RESET_DELAY_MS);
+	gx_gpio(GX_IRQ, 0, 3, 8, -1);
+
+	int err;
+	if ((err = gx_dev_confirm()) || (err = gx_read_version()) ||
+	    (err = gx_read_ic_info())) {
+		printf("GX TOUCH: init failed %d\n", err);
+		goto out;
+	}
+	printf("GX TOUCH: sensing, polling GPIO%u\n", GX_IRQ);
+
+	uint64_t poll_abs, idle_abs;
+	nanoseconds_to_absolutetime(poll_us * 1000ULL, &poll_abs);
+	nanoseconds_to_absolutetime(32 * 1000ULL * 1000ULL, &idle_abs);
+	uint64_t next = mach_absolute_time();
+	bool was_off = false;
+	for (;;) {
+		bool off = sweet_fb_display_off;
+		if (off != was_off) {
+			was_off = off;
+			if (off && gx.active) {
+				gx_poll(false);   /* consume and drop */
+			}
+		}
+		bool irq = !(gx_rd(gx.tlmm, GX_GPIO(GX_IRQ) + 4) & 1u);
+		if (!off && (irq || gx.active)) {
+			gx_poll(true);
+		} else if (off || !irq) {
+			/* still sweep at 32 ms in case the line does not assert */
+			if (!off) {
+				gx_poll(false);
+			}
+		}
+		uint64_t period = off ? idle_abs :
+		    (gx.active || irq) ? poll_abs : idle_abs;
+		next += period;
+		uint64_t now = mach_absolute_time();
+		if (next <= now) {
+			next = now + period;
+		}
+		/* sleep like fuxi_touch.c: assert on the thread chan address */
+		{
+			static int chan;
+			uint64_t dl;
+			clock_interval_to_deadline(poll_us / 1000 + 1, NSEC_PER_MSEC, &dl);
+			(void)assert_wait_deadline(&chan, THREAD_UNINT, dl);
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+	}
+out:
+	printf("GX TOUCH: stopped\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+fuxi_touch_goodix_init(void)
+{
+	thread_t thread;
+	if (gx.started) {
+		return;
+	}
+	gx.started = true;
+	if (kernel_thread_start_priority(gx_thread, NULL, GX_PRIORITY,
+	    &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
