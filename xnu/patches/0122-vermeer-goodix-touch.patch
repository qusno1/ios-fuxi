+static int
+gx_se_fw_load(void)
+{
+	uint32_t fw = gx_rd(gx.se, GENI_FW_REVISION);
+	printf("GX TOUCH: SE fw before load %#x\n", fw);
+	if (((fw >> 8) & 0xff) == GX_SEFW_PROTO) {
+		return 0;                       /* I2C firmware already resident */
+	}
+	/* unlock the SE for firmware loading */
+	gx_wr(gx.se, SE_FW_MULTILOCK_PROTS, 0);
+	gx_wr(gx.se, SE_FW_MULTILOCK_MSA, 0);
+	/* stop the core and clock the program RAM */
+	gx_wr(gx.se, GENI_OUTPUT_CTRL, 0);
+	gx_wr(gx.se, GENI_DFS_IF_CFG, gx_rd(gx.se, GENI_DFS_IF_CFG) & ~1u);
+	gx_wr(gx.se, GENI_CGC_CTRL, gx_rd(gx.se, GENI_CGC_CTRL) | GX_CGC_PROG_RAM_OFF);
+	gx_wr(gx.se, SE_GENI_CLK_CTRL, 0);
+	gx_wr(gx.se, GENI_CGC_CTRL, gx_rd(gx.se, GENI_CGC_CTRL) & ~GX_CGC_PROG_RAM_OFF);
+	/* the SE clock stays as the loader left it (no DFSR re-config) */
+	gx_wr(gx.se, SE_DMA_GENERAL_CFG, GX_DMA_GENERAL_CGC);
+	gx_wr(gx.se, GENI_CGC_CTRL, DEFAULT_CGC_EN);
+	/* config revisions + the SEFW cfg register array (I2C timing et al.) */
+	gx_wr(gx.se, GENI_INIT_CFG_REVISION, GX_SEFW_CFG_VER);
+	gx_wr(gx.se, GENI_S_INIT_CFG_REVISION, GX_SEFW_CFG_VER);
+	for (unsigned i = 0; i < GX_SEFW_CFG_N; i++) {
+		gx_wr(gx.se, SE_GENI_CFG_REG0 + gx_sefw_cfg_idx[i] * 4,
+		    gx_sefw_cfg_val[i]);
+	}
+	gx_wr(gx.se, GENI_OUTPUT_CTRL,
+	    gx_rd(gx.se, GENI_OUTPUT_CTRL) | DEFAULT_IO_OUTPUT_CTRL);
+	/* GPI-DMA mode with the GSI event path */
+	gx_wr(gx.se, GENI_DMA_MODE, gx_rd(gx.se, GENI_DMA_MODE) | 1u);
+	gx_wr(gx.se, GENI_SE_IRQ_EN, 0);
+	gx_wr(gx.se, SE_GSI_EVENT_EN, GX_SE_GSI_EVENT_EN);
+	gx_wr(gx.se, GENI_M_IRQ_EN, GX_M_COMMON_IRQ_EN);
+	gx_wr(gx.se, GENI_S_IRQ_EN, GX_S_IRQ_EN);
+	gx_wr(gx.se, SE_DMA_TX_IRQ_EN_SET, GX_DMA_TX_IRQ_SET);
+	gx_wr(gx.se, SE_DMA_RX_IRQ_EN_SET, GX_DMA_RX_IRQ_SET);
+	/* firmware revisions + the program RAM image */
+	gx_wr(gx.se, SE_GENI_FW_REVISION, (GX_SEFW_PROTO << 8) | GX_SEFW_VERSION);
+	gx_wr(gx.se, SE_GENI_S_FW_REVISION, (GX_SEFW_PROTO << 8) | GX_SEFW_VERSION);
+	for (unsigned i = 0; i < GX_SEFW_WORDS_N; i++) {
+		gx_wr(gx.se, SE_GENI_CFG_RAMN + 4 * i, gx_sefw_words[i]);
+	}
+	/* restart the program RAM, then the serial engine clock */
+	gx_wr(gx.se, GENI_FORCE_DEFAULT, 1);
+	gx_wr(gx.se, GENI_CGC_CTRL, gx_rd(gx.se, GENI_CGC_CTRL) | GX_CGC_PROG_RAM_OFF);
+	gx_wr(gx.se, SE_GENI_CLK_CTRL, gx_rd(gx.se, SE_GENI_CLK_CTRL) | 1u);
+	gx_wr(gx.se, GENI_CGC_CTRL, gx_rd(gx.se, GENI_CGC_CTRL) & ~GX_CGC_PROG_RAM_OFF);
+	/* DMA interface on, FIFO interface off */
+	gx_wr(gx.se, SE_DMA_IF_EN, gx_rd(gx.se, SE_DMA_IF_EN) | 1u);
+	gx_wr(gx.se, SE_FIFO_IF_DISABLE, gx_rd(gx.se, SE_FIFO_IF_DISABLE) | 1u);
+	gx_wr(gx.se, SE_GENI_CLK_CTRL, 1);
+	/* lock the SE against further FW loads */
+	gx_wr(gx.se, SE_FW_MULTILOCK_PROTS, 1);
+	gx_wr(gx.se, SE_FW_MULTILOCK_MSA, 1);
+	for (unsigned i = 0; i < 50000; i++) {
+		fw = gx_rd(gx.se, GENI_FW_REVISION);
+		if (((fw >> 8) & 0xff) == GX_SEFW_PROTO) {
+			printf("GX TOUCH: SE fw loaded %#x after %u us\n", fw, i);
+			return 0;
+		}
+		delay(1);
+	}
+	printf("GX TOUCH: SE fw load timeout (fw %#x)\n", fw);
+	return ETIMEDOUT;
+}
